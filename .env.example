DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-local-mysql-root-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password
RAZORPAY_API_KEY=replace-with-your-razorpay-key
RAZORPAY_API_SECRET=replace-with-your-razorpay-secret
# Optional. Omit or leave blank to disable Stripe; Razorpay remains available.
STRIPE_API_KEY=
GEMINI_API_KEY=
MAIL_USERNAME=replace-with-your-mail-address
MAIL_PASSWORD=replace-with-your-mail-password
JWT_SECRET=replace-with-a-long-random-secret
# Use a different random key in production; local Compose falls back to JWT_SECRET for compatibility.
INTERNAL_SERVICE_JWT_SECRET=replace-with-a-distinct-long-random-secret
# Public frontend origin for password-reset links and payment return URLs.
FRONTEND_BASE_URL=http://localhost:5173
# Browser-reachable API Gateway URL, embedded in the frontend image at build time.
VITE_API_BASE_URL=http://localhost:5000
# Comma-separated exact browser origins accepted by API Gateway CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional local-only bootstrap. Created only when userdb has no users; use a unique password of at least 12 characters.
LOCAL_SUPER_ADMIN_EMAIL=
LOCAL_SUPER_ADMIN_PASSWORD=
ML_MAX_REQUEST_BYTES=262144
ML_REQUESTS_PER_MINUTE=60
# POS checkout tax rate. Tax is calculated on the original subtotal before discount.
ORDER_TAX_RATE_PERCENT=18
# Branch discount limits are stored per branch and set by its Branch Manager.
